# Copy this file to keystore.properties (same folder) and fill in your own
# values, then put your .jks next to it.
#
#     cp keystore.properties.example keystore.properties
#
# Both keystore.properties and *.jks are gitignored -- never commit them.
#
# If keystore.properties is missing, the release build still works but is
# unsigned (or signed with the debug key), which is fine for local testing
# and not fine for distribution.

storeFile=sakura-release.jks
storePassword=CHANGE_ME
keyAlias=sakura
keyPassword=CHANGE_ME

# To create a new keystore:
#
#     keytool -genkeypair -v -keystore sakura-release.jks ^
#       -alias sakura -keyalg RSA -keysize 2048 -validity 10000
#
# Keep a backup. If you lose it you cannot ship updates to an installed app.
